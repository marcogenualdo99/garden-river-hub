rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// garden-river-conti-febed  —  STATO ATTUALE (pre-consolidamento), ripulito
//
// Sono le regole già online su questo progetto, con due sole correzioni:
//   ~ 'bici' da `if true` (aperta a chiunque) → `if request.auth != null`
//   - rimosse le righe duplicate (ordini_ristorazione ripetuta 3x)
// NON include operatori-hub/permessi/home_layout/meta/prodotti/categorie:
// per quelle vedi il file -CONSOLIDATO.
//
// Usa questo file solo come RIFERIMENTO / ROLLBACK se il consolidamento salta.
// Per il cutover si deploya -CONSOLIDATO.
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    match /ospiti/{id}                 { allow read, write: if request.auth != null; }
    match /ordini/{id}                 { allow read, write: if request.auth != null; }
    match /bici/{id}                   { allow read, write: if request.auth != null; } // era `if true`
    match /staffTokens/{id}            { allow read, write: if request.auth != null; }
    match /operatori/{id}              { allow read, write: if request.auth != null; }
    match /_test/{id}                  { allow read, write: if request.auth != null; }
    match /test_notifiche/{id}         { allow read, write: if request.auth != null; } // legacy, non usata
    match /alloggi/{id}                { allow read, write: if request.auth != null; }
    match /menu_ristorazione/{id}      { allow read, write: if request.auth != null; }
    match /famiglie_ristorazione/{id}  { allow read, write: if request.auth != null; }
    match /ordini_ristorazione/{id}    { allow read, write: if request.auth != null; }
    match /maintenance_tickets/{id}    { allow read, write: if request.auth != null; }
    match /beach_spiagge/{id}          { allow read, write: if request.auth != null; }
    match /beach_prenotazioni/{id}     { allow read, write: if request.auth != null; }
    match /impostazioni/{id}           { allow read, write: if request.auth != null; }
    match /listini/{id}                { allow read, write: if request.auth != null; }
    match /prenotazioni/{prenId} {
      allow read, write: if request.auth != null;
      match /log/{logId} {
        allow read, write: if request.auth != null;
      }
    }
    // Copie delle prenotazioni cancellate — restano leggibili nello Storico
    // ospite del Calendario. Non si possono cancellare da client.
    match /prenotazioni_eliminate/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
