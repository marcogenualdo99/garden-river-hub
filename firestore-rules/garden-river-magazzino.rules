rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// PROGETTO FIREBASE: garden-river-magazzino
// Database dedicato al Magazzino Bar (prodotti e categorie). Separato dagli
// altri per ragioni storiche.
//
// MODELLO DI SICUREZZA — vedi note complete in garden-river-hub.rules.
// autenticazione client anonima; senza login non si legge/scrive nulla;
// solo le collezioni elencate; il resto è negato.
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Prodotti del bar — { nome, pz, min, categoria, ... }
    match /prodotti/{id}    { allow read, write: if signedIn(); }

    // Categorie prodotti
    match /categorie/{id}   { allow read, write: if signedIn(); }

    // Ping di verifica connessione
    match /_test/{id}       { allow read, write: if signedIn(); }

    // Tutto il resto: negato.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
