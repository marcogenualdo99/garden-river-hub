rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// garden-river-conti-febed  —  REGOLE DOPO IL CONSOLIDAMENTO
//
// Punto di partenza: le regole ATTUALI di questo progetto (fornite dalla
// console). Rispetto a quelle, qui cambia SOLO:
//
//   + aggiunte le collezioni migrate da garden-river-hub:
//       operatori (già c'era), permessi, home_layout, meta
//   + aggiunte le collezioni migrate da garden-river-magazzino:
//       prodotti, categorie
//   ~ 'bici' passa da  `if true`  (aperta a CHIUNQUE, anche senza login!)
//       a  `if request.auth != null`  — allineata a tutte le altre
//   - rimosse le righe duplicate (ordini_ristorazione era ripetuta 3 volte)
//
// Tutto il resto è identico a prima. La sottocollezione prenotazioni/{id}/log
// è mantenuta (change-log per prenotazione, usata da Calendario).
//
// MODELLO: autenticazione client anonima → i ruoli restano lato app; chi non
// ha fatto login non accede a nulla; le Cloud Function e GitHub Actions usano
// un service account che bypassa queste regole.
//
// ⚠️ LIMITI NOTI: i dati Alloggiati Web in 'ospiti'/'prenotazioni' restano
// leggibili da chi è autenticato (anche solo in anonimo). Chiusura completa =
// login non anonimo / token di sessione firmato.
//
// ✅ PIN operatore: NON sono più in 'operatori'. La verifica avviene sulla
// Cloud Function 'auth-operatori', che è l'unica a leggere/scrivere
// 'operatori_pin/{nome}' (hash salato). Quella collezione è negata a tutti i
// client qui sotto.
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── ex garden-river-hub ────────────────────────────────────────────────
    match /operatori/{id} {
      allow read, write: if request.auth != null;   // { nome, ruolo, haPin } — niente PIN qui
    }
    // Hash salati dei PIN. Li gestisce SOLO la Cloud Function 'auth-operatori'
    // (Admin SDK, che ignora queste regole). Nessun client deve leggerli.
    match /operatori_pin/{id} {
      allow read, write: if false;
    }
    match /permessi/{id} {
      allow read, write: if request.auth != null;
    }
    match /home_layout/{id} {
      allow read, write: if request.auth != null;   // id = nome operatore
    }
    match /meta/{id} {
      allow read, write: if request.auth != null;
    }

    // ── ex garden-river-magazzino ──────────────────────────────────────────
    match /prodotti/{id} {
      allow read, write: if request.auth != null;
    }
    match /categorie/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Conti / pensioni ──────────────────────────────────────────────────
    match /ospiti/{id} {
      allow read, write: if request.auth != null;   // ospiti pensione + dati Alloggiati Web
    }
    match /ordini/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Calendario / prenotazioni ────────────────────────────────────────
    match /prenotazioni/{prenId} {
      allow read, write: if request.auth != null;
      match /log/{logId} {
        allow read, write: if request.auth != null;
      }
    }
    match /listini/{id} {
      allow read, write: if request.auth != null;
    }
    match /impostazioni/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Pulizie / alloggi ────────────────────────────────────────────────
    match /alloggi/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Noleggio bici ────────────────────────────────────────────────────
    match /bici/{id} {
      allow read, write: if request.auth != null;   // era `if true` — ORA richiede login
    }

    // ── Ristorazione ─────────────────────────────────────────────────────
    match /famiglie_ristorazione/{id} {
      allow read, write: if request.auth != null;
    }
    match /ordini_ristorazione/{id} {
      allow read, write: if request.auth != null;
    }
    match /menu_ristorazione/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Manutenzione ─────────────────────────────────────────────────────
    match /maintenance_tickets/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Spiaggia ─────────────────────────────────────────────────────────
    match /beach_spiagge/{id} {
      allow read, write: if request.auth != null;
    }
    match /beach_prenotazioni/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Notifiche push ───────────────────────────────────────────────────
    match /staffTokens/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Verifica connessione ─────────────────────────────────────────────
    match /_test/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Fiscalizzazione condivisa ────────────────────────────────────────
    // config/fiscalizzazione = { token, proxy_url } — lo legge l'app per
    // chiamare il proxy condiviso. Il token si imposta SOLO dalla console
    // (è un segreto): scrittura negata ai client.
    match /config/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Registro degli scontrini fiscali emessi: append-only, nessuna modifica
    // o cancellazione dai client.
    match /scontrini_fiscali/{id} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Legacy: nessun riferimento nel codice, candidato alla rimozione ──
    match /test_notifiche/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
